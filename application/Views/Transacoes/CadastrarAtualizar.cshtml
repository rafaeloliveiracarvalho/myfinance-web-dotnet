@model myfinance_web_dotnet.Models.TransacaoModel

@{
    ViewData["Title"] = "Cadastrar ou Atualizar Transação";
}

<h1>@ViewData["Title"]</h1>

<div>
    <form asp-controller="Transacoes" asp-action="CadastrarAtualizar" method="post">
        <input type="hidden" asp-for="Id" /><br>

        <div class="form-group">
            <label asp-for="Descricao">Descrição</label>
            <input type="text" asp-for="Descricao" class="form-control" /><br>
        </div>

        <div class="form-group">
            <label asp-for="Valor">Valor</label>
            <input type="number" step="0.01" asp-for="Valor" class="form-control" /><br>
        </div>

        <div class="form-group">

            <label asp-for="Data">Data</label>
            <input type="date" asp-for="Data" class="form-control" /><br>
        </div>

        <div class="form-group">
            <label asp-for="CategoriaId">Categoria</label>
            <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-control">
                <option value="">-- Selecione --</option>
            </select>
        </div>

        <span asp-validation-for="CategoriaId" class="text-danger"></span>
        <br><br>
        <button type="submit" class="btn btn-block btn-success">Registrar</button>
    </form>
</div>
